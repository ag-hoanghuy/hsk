# Copy to .env to override defaults (not required for first run).
POSTGRES_USER=hsk
POSTGRES_PASSWORD=hsk_dev
POSTGRES_DB=hsk

# Speaking assessment: speech-recognition model used offline (downloaded once into ./models).
# tiny / base / small / medium; "small" is the default (about 460 MB, ~1.5 s per sentence on CPU).
WHISPER_MODEL=small
